# --- Python -----------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*$py.class
*.so

# --- Virtual envs / packaging ----------------------------------------
.venv/
venv/
env/
.python-version
*.egg-info/
build/
dist/
pip-wheel-metadata/

# uv keeps a single lockfile at the workspace root; per-member lock
# files are an accident and should not be committed.
# (Keep uv.lock at the repo root; ignore stray ones here.)
/uv.lock

# --- Tooling caches ---------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# --- Project artefacts ------------------------------------------------
# Generated CSV exports; never check these in.
exports/
exports/*
# Half-written outputs that should already be cleaned up by the job,
# but ignore them in case of a hard crash mid-write.
*.partial

# Prometheus multiprocess scratch directory (if you run with a fixed
# path during local dev instead of a tmpdir).
prom_multiproc/

# --- IDE / OS ---------------------------------------------------------
.idea/
.vscode/
.DS_Store
Thumbs.db

# --- Logs / scratch ---------------------------------------------------
*.log
logs/
*.swp
*.swo
