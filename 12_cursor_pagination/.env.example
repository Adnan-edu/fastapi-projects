# PostgreSQL
POSTGRES_USER=cursor
POSTGRES_PASSWORD=cursor
POSTGRES_DB=cursor_pagination
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Async driver URL used by SQLAlchemy/asyncpg
DATABASE_URL=postgresql+asyncpg://cursor:cursor@localhost:5432/cursor_pagination

# Raw asyncpg URL (no driver suffix) for ingestion COPY
ASYNCPG_URL=postgresql://cursor:cursor@localhost:5432/cursor_pagination

# App
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=info

# Pagination defaults
DEFAULT_PAGE_LIMIT=50
MAX_PAGE_LIMIT=500

# Ingestion
CSV_PATH=data/order_events_1m.csv
INGEST_BATCH_SIZE=50000
