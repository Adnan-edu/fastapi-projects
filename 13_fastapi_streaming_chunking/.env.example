# PostgreSQL
POSTGRES_USER=stream
POSTGRES_PASSWORD=stream
POSTGRES_DB=stream_pagination
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Async driver URL used by SQLAlchemy/asyncpg
DATABASE_URL=postgresql+asyncpg://stream:stream@localhost:5433/stream_pagination

# Raw asyncpg URL (no driver suffix) — used by helper scripts if needed
ASYNCPG_URL=postgresql://stream:stream@localhost:5433/stream_pagination

# App
APP_HOST=0.0.0.0
APP_PORT=8001
APP_LOG_LEVEL=info

# Streaming knobs
STREAM_CHUNK_SIZE=1000        # rows per yield batch (server-side cursor window)
STREAM_MAX_ROWS=0             # 0 = unbounded; otherwise hard cap per request
