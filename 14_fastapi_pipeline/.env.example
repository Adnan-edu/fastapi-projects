# Copy to .env and fill in your local values.
# Never commit the real .env — it is ignored by .gitignore.

# Local dev Postgres (docker container "stream_pg")
DATABASE_URL=postgresql+asyncpg://stream:CHANGE_ME@localhost:5433/stream_pagination

APP_HOST=0.0.0.0
APP_PORT=8002
APP_LOG_LEVEL=info

PIPELINE_CHUNK_SIZE=1000
PIPELINE_MAX_ROWS=0

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20